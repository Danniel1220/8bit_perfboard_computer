{
  "schema_version": 1,
  "name": "Connector example",
  "board": {
    "width": 14,
    "height": 10,
    "pitch_mm": 2.54,
    "svg_pitch": 7.2
  },
  "constants": {
    "VCC": 1,
    "GND": 0
