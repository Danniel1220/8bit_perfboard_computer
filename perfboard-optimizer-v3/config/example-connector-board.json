      "rotations": [
        0
      ],
      "edges": [
        "left"
      ],
      "reorder_pins": true,
      "group": "io"
    },
    {
      "id": "OUT",
      "package": "J",
      "function": "connector",
      "initial": {
        "x": 12,
        "y": 2,
        "rotation": 0,
        "edge": "right"
      },
      "pin_nets": {
        "1": "A",
        "2": "B"
      },
      "fixed": false,
      "rotations": [
        0
      ],
      "edges": [
        "right"
      ],
      "reorder_pins": true,
      "group": "io"
    }
